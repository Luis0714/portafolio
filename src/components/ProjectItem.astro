---
import GitHubIcon from "../assets/icons/GitHubIcon.astro";
import EthernetIcon from "../assets/icons/EthernetIcon.astro";
import SocialBadge from "./SocialBadge.astro";
import Tag from "./Tag.astro";
import type { TypeTag } from "../interfaces/tag";

interface Props {
  title: string;
  description: string;
  image: string;
  tags: TypeTag[];
  link: string;
  github: string;
}

const { title, description, image, tags, link, github } = Astro.props as Props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200/80 bg-white/70 shadow-sm backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-brand-500/30"
>
  <div class="relative overflow-hidden">
    <img
      class="h-48 w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      src={image}
      alt={`Captura del proyecto ${title}`}
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{title}</h3>
    <p class="mt-2 flex-1 text-pretty text-sm leading-relaxed text-gray-600 dark:text-gray-300">
      {description}
    </p>
    <nav class="mt-4 flex flex-wrap gap-2" aria-label={`Tecnologías de ${title}`}>
      {
        tags.map((tag) => (
          <Tag>
            {tag.name}
            <tag.icon class="size-4" />
          </Tag>
        ))
      }
    </nav>

    <nav
      class="mt-6 grid grid-cols-2 gap-2"
      aria-label={`Enlaces de ${title}`}
    >
      <SocialBadge
        href={link}
        variant="primary"
        size="sm"
        external
        class="w-full justify-center whitespace-nowrap"
      >
        <EthernetIcon class="size-4 shrink-0" />
        Ver proyecto
      </SocialBadge>
      <SocialBadge
        href={github}
        size="sm"
        external
        class="w-full justify-center whitespace-nowrap"
      >
        <GitHubIcon class="size-4 shrink-0" />
        Ver código
      </SocialBadge>
    </nav>
  </div>
</article>

