---
import ArrowIcon from '../assets/icons/ArrowIcon.astro';

interface Props {
  title: string;
  date: string;
  description: string;
  link?: string;
}
const { title, date, description, link } = Astro.props;
---

<div
  class="absolute w-3 h-3 bg-blue-500 dark:bg-blue-400 rounded-full mt-1.5 -start-1.5 border-2 border-white dark:border-gray-900 shadow-sm"
>
</div>
<time
  class="mb-1 text-sm font-normal leading-none text-gray-600 dark:text-gray-400"
  >{date}</time
>
<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
  {title}
</h3>
<p class="mb-4 text-base font-normal text-gray-700 dark:text-gray-300 text-pretty">{description}</p>
{
  link && (
    <a
      href={link}
      class="mt-2 gap-2 inline-flex items-center px-4 py-2 text-sm font-medium rounded-full border border-gray-300 dark:border-white/10 bg-white dark:bg-white/5 hover:scale-110 hover:bg-gray-100 dark:hover:bg-white/10 transition text-gray-800 dark:text-white shadow-sm dark:shadow-none"
    >
      Saber más
      <ArrowIcon class="size-4" />
    </a>
  )
}
