---
import ArrowIcon from "../assets/icons/ArrowIcon.astro";

interface Props {
  title: string;
  date: string;
  description: string;
  link?: string;
}

const { title, date, description, link } = Astro.props;
---

<article
  class="group relative rounded-2xl border border-gray-200/80 bg-white/60 p-5 backdrop-blur-sm transition-all duration-300 hover:border-brand-200 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-brand-500/30 dark:hover:shadow-brand-500/5"
>
  <div
    class="absolute -left-[1.35rem] top-6 size-3 rounded-full border-2 border-white bg-brand-500 shadow-sm ring-4 ring-brand-100 dark:border-neutral-950 dark:ring-brand-500/20"
    aria-hidden="true"
  >
  </div>
  <time
    class="mb-2 inline-block rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-400"
    datetime={date}
  >
    {date}
  </time>
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{title}</h3>
  <p class="mt-2 text-pretty text-base leading-relaxed text-gray-600 dark:text-gray-300">
    {description}
  </p>
  {
    link && (
      <a
        href={link}
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-800 transition-all hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:border-brand-500/40 dark:hover:bg-brand-500/10"
        target="_blank"
        rel="noopener noreferrer"
      >
        Saber más
        <ArrowIcon class="size-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</article>

