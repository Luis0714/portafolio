---
import SocialBadge from "./SocialBadge.astro";
import LinkedInIcon from "../assets/icons/LinkedInIcon.astro";
import SendMailIcon from "../assets/icons/SendMailIcon.astro";
---

<section
  class="overflow-hidden rounded-2xl border border-gray-200/80 bg-white/70 p-8 shadow-sm backdrop-blur-sm dark:border-white/10 dark:bg-white/[0.03] sm:p-10"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-lg">
    <h2
      id="contact-heading"
      class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
    >
      Hablemos <span class="text-accent-500 dark:text-accent-400">ahora</span>
    </h2>
    <p class="mt-3 text-pretty leading-relaxed text-gray-600 dark:text-gray-300">
      Cuéntame sobre tu proyecto, vacante o colaboración. Respondo en 24–48 horas hábiles.
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      <SocialBadge href="https://www.linkedin.com/in/martinezestremor/" size="sm" external>
        <LinkedInIcon class="size-4 shrink-0" />
        LinkedIn
      </SocialBadge>
      <SocialBadge href="mailto:luian.me0714@gmail.com" size="sm">
        <SendMailIcon class="size-4 shrink-0" />
        luian.me0714@gmail.com
      </SocialBadge>
    </div>

    <form id="contactForm" class="mt-8 space-y-5" novalidate>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="website">No completar</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-200">
          Tu nombre
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
          placeholder="¿Cómo te llamas?"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-white/10 dark:bg-neutral-900 dark:text-gray-100 dark:placeholder:text-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400/20"
        />
      </div>

      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-200">
          Tu correo electrónico
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="tu@email.com"
          class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-white/10 dark:bg-neutral-900 dark:text-gray-100 dark:placeholder:text-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400/20"
        />
      </div>

      <div>
        <label
          for="message"
          class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-200"
        >
          Tu mensaje
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          maxlength="2000"
          placeholder="Cuéntame en qué puedo ayudarte..."
          class="w-full resize-none rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-gray-900 transition-colors placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-white/10 dark:bg-neutral-900 dark:text-gray-100 dark:placeholder:text-gray-500 dark:focus:border-brand-400 dark:focus:ring-brand-400/20"
        ></textarea>
      </div>

      <p
        id="contact-form-status"
        class="hidden rounded-xl px-4 py-3 text-sm"
        role="status"
        aria-live="polite"
      >
      </p>

      <button
        id="contact-submit"
        type="submit"
        class="w-full rounded-xl bg-brand-600 py-3 text-sm font-semibold text-white shadow-md transition-all hover:bg-brand-700 hover:shadow-lg active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-60 dark:bg-brand-500 dark:hover:bg-brand-600"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const statusEl = document.getElementById("contact-form-status");

    const setStatus = (message: string, type: "success" | "error") => {
      if (!statusEl) return;

      statusEl.textContent = message;
      statusEl.classList.remove("hidden", "bg-emerald-50", "text-emerald-800", "dark:bg-emerald-500/10", "dark:text-emerald-300", "bg-red-50", "text-red-800", "dark:bg-red-500/10", "dark:text-red-300");

      if (type === "success") {
        statusEl.classList.add("bg-emerald-50", "text-emerald-800", "dark:bg-emerald-500/10", "dark:text-emerald-300");
      } else {
        statusEl.classList.add("bg-red-50", "text-red-800", "dark:bg-red-500/10", "dark:text-red-300");
      }
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get("name") ?? "").trim(),
        email: String(formData.get("email") ?? "").trim(),
        message: String(formData.get("message") ?? "").trim(),
        website: String(formData.get("website") ?? "").trim(),
      };

      submitBtn?.setAttribute("disabled", "true");
      const defaultLabel = submitBtn?.textContent ?? "Enviar mensaje";
      if (submitBtn) submitBtn.textContent = "Enviando...";
      statusEl?.classList.add("hidden");

      try {
        const response = await fetch("/endpoints/send-email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = (await response.json()) as { ok?: boolean; error?: string };

        if (!response.ok) {
          setStatus(data.error ?? "No se pudo enviar el mensaje. Intenta de nuevo.", "error");
          return;
        }

        setStatus("¡Mensaje enviado! Te responderé pronto.", "success");
        form.reset();
      } catch {
        setStatus("Error de conexión. Revisa tu red e intenta de nuevo.", "error");
      } finally {
        submitBtn?.removeAttribute("disabled");
        if (submitBtn) submitBtn.textContent = defaultLabel;
      }
    });
  })();
</script>
