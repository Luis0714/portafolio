---
import LinkedInIcon from "../assets/icons/LinkedInIcon.astro";
import ProfilePhoto from "../components/ProfilePhoto.astro";
import GitHubIcon from "../assets/icons/GitHubIcon.astro";
import SendMailICon from "../assets/icons/SendMailIcon.astro";
import SocialBadge from "../components/SocialBadge.astro";
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BriefCase from "../assets/icons/BriefCase.astro";
import CodeIcon from "../assets/icons/CodeIcon.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import YouTube from "../assets/icons/Youtube.astro";
import Facebook from "../assets/icons/Facebook.astro";
import TikTok from "../assets/icons/TikTok.astro";
import Kick from "../assets/icons/Kick.astro";
---

<Layout
  title="Luis Andrés Martínez Estremor – Desarrollador Full Stack (.NET, Angular, Java y React)"
  description="Desarrollador Full Stack con más de 3 años de experiencia en .NET, Angular, Java y React. Construyo aplicaciones web empresariales con arquitectura limpia, APIs y microservicios. Basado en Manizales, Colombia."
>
  <main>
    <SectionContainer id="home" class="pb-12 pt-10 sm:pt-14">
      <div class="reveal flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-10">
        <ProfilePhoto />

        <div class="min-w-0 flex-1">
          <p
            class="reveal reveal-delay-1 mb-3 inline-flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400"
          >
            <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
            Disponible para nuevos proyectos
          </p>

          <h1
            class="reveal reveal-delay-1 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl lg:text-5xl"
          >
            Luis Andrés Martínez Estremor
          </h1>

          <p
            class="reveal reveal-delay-1 mt-2 text-lg font-semibold text-brand-600 dark:text-brand-400 sm:text-xl"
          >
            Desarrollador Full Stack · .NET, Angular, Java & React
          </p>

          <p
            class="reveal reveal-delay-2 mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-gray-600 dark:text-gray-300"
          >
            <span class="font-semibold text-brand-600 dark:text-brand-400"
              >+3 años de experiencia</span
            >
            diseñando y desarrollando aplicaciones web de punta a punta: APIs REST, microservicios y
            frontends con
            <span class="font-semibold text-accent-600 dark:text-accent-400">.NET</span>,
            <span class="font-semibold text-accent-600 dark:text-accent-400">Angular</span>,
            <span class="font-semibold text-accent-600 dark:text-accent-400">Java</span>
            y
            <span class="font-semibold text-accent-600 dark:text-accent-400">React</span>. En Opitech
            entrego software mantenible con arquitectura limpia, SOLID y patrones de diseño. Monitor
            de Programación en la Universidad de Caldas. Desde Manizales, Colombia —
            <span class="font-semibold text-accent-600 dark:text-accent-400"
              >disponible para proyectos, trabajo remoto y nuevas oportunidades.</span
            >
          </p>

          <div class="reveal reveal-delay-3 mt-6 flex flex-wrap items-center gap-2">
            <SocialBadge href="#projects" variant="primary" size="sm">
              Ver proyectos
            </SocialBadge>
            <SocialBadge href="#contact" size="sm">
              Contactar
            </SocialBadge>
            <SocialBadge href="https://www.youtube.com/@ESTREMORDEV" size="sm" external>
              Sígueme
            </SocialBadge>
          </div>
        </div>
      </div>

      <nav
        id="redes-sociales"
        class="reveal reveal-delay-3 mt-8 flex flex-wrap items-center gap-2"
        aria-label="Redes sociales"
      >
        <SocialBadge href="https://www.youtube.com/@ESTREMORDEV" size="sm" external>
          <YouTube class="size-4 shrink-0" />
          YouTube
        </SocialBadge>
        <SocialBadge href="https://www.tiktok.com/@estremordev" size="sm" external>
          <TikTok class="size-4 shrink-0" />
          TikTok
        </SocialBadge>
        <SocialBadge href="https://kick.com/estremordev" size="sm" external>
          <Kick class="size-4 shrink-0" />
          Kick
        </SocialBadge>
        <SocialBadge href="https://www.facebook.com/estremordev" size="sm" external>
          <Facebook class="size-4 shrink-0" />
          Facebook
        </SocialBadge>
        <SocialBadge href="https://www.linkedin.com/in/martinezestremor/" size="sm" external>
          <LinkedInIcon class="size-4 shrink-0" />
          LinkedIn
        </SocialBadge>
        <SocialBadge href="https://github.com/Luis0714" size="sm" external>
          <GitHubIcon class="size-4 shrink-0" />
          GitHub
        </SocialBadge>
        <SocialBadge href="mailto:luian.me0714@gmail.com" size="sm">
          <SendMailICon class="size-4 shrink-0" />
          Email
        </SocialBadge>
      </nav>
    </SectionContainer>

    <SectionContainer id="experience">
      <SectionHeading>
        <BriefCase slot="icon" class="size-5" />
        Experiencia laboral
        <span slot="subtitle">Trayectoria, habilidades y conocimientos</span>
      </SectionHeading>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects">
      <SectionHeading>
        <CodeIcon slot="icon" class="size-5" />
        Proyectos y logros
        <span slot="subtitle">Trabajo reciente y resultados destacados</span>
      </SectionHeading>
      <Projects />
    </SectionContainer>

    <SectionContainer id="contact" class="pb-24">
      <Contact />
    </SectionContainer>
  </main>
</Layout>
