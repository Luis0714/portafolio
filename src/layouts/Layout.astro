---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
}

const { description, title, canonicalUrl = "https://estremor.com" } = Astro.props;
const currentUrl = Astro.url.href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luis Andrés Martínez Estremor" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="desarrollador .NET, desarrollador Angular, desarrollador web Colombia, programador .NET, desarrollador full stack, arquitectura limpia, SOLID, TypeScript, C#, Luis Martínez Estremor, portafolio desarrollador" />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Manizales, Colombia" />
    <meta name="geo.position" content="5.0697;-75.5138" />
    <meta name="ICBM" content="5.0697, -75.5138" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="https://estremor.com/images/favicon.svg" />
    <link rel="alternate icon" href="https://estremor.com/images/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://estremor.com/images/apple-touch-icon.png" />
    <link rel="manifest" href="https://estremor.com/images/site.webmanifest" />

    <!-- Open Graph (Facebook, LinkedIn...) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta
      property="og:image"
      content="https://estremor.com/preview.webp"
    />
    <meta property="og:image:secure_url" content="https://estremor.com/preview.webp" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@estremordev" />
    <meta
      name="twitter:image"
      content="https://estremor.com/preview.webp"
    />
    <meta name="twitter:image:alt" content="Luis Andrés Martínez Estremor - Desarrollador .NET y Angular" />

    <!-- WhatsApp -->
    <meta property="og:site_name" content="Estremor" />
    <meta property="og:image:alt" content="Luis Andrés Martínez Estremor - Desarrollador .NET y Angular" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#050505" />
    <meta name="msapplication-TileColor" content="#050505" />
    <meta name="msapplication-TileImage" content="/mstile-150x150
.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest+Variable:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/animations.css" />
    <link rel="stylesheet" href="/styles/typography.css" />
    <link rel="stylesheet" href="/styles/components.css" />
    <link rel="stylesheet" href="/styles/layout.css" />
    <link rel="stylesheet" href="/styles/sections.css" />
    <link rel="stylesheet" href="/styles/animations.css" />
    <link rel="stylesheet" href="/styles/scrollbar.css" />
    <link rel="stylesheet" href="/styles/scrollbar.css" />
    <link rel="stylesheet" href="/styles/animations.css" />
    <link rel="stylesheet" href="/styles/typography.css" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Luis Andrés Martínez Estremor",
      "alternateName": "Estremor",
      "jobTitle": "Desarrollador Full Stack",
      "description": description,
      "url": "https://estremor.com",
      "image": "https://estremor.com/images/luisandres.jpg",
      "email": "luian.me0714@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Manizales",
        "addressRegion": "Caldas",
        "addressCountry": "CO"
      },
      "sameAs": [
        "https://www.linkedin.com/in/martinezestremor/",
        "https://github.com/Luis0714",
        "https://www.youtube.com/@ESTREMORDEV",
        "https://www.tiktok.com/@estremordev",
        "https://kick.com/estremordev",
        "https://www.facebook.com/estremordev"
      ],
      "knowsAbout": [
        ".NET",
        "Angular",
        "TypeScript",
        "C#",
        "Arquitectura Limpia",
        "SOLID",
        "Desarrollo Web",
        "Full Stack Development"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Desarrollador autodidacta desde 2022"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Estremor - Portafolio de Luis Andrés Martínez Estremor",
      "url": "https://estremor.com",
      "description": description,
      "author": {
        "@type": "Person",
        "name": "Luis Andrés Martínez Estremor"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://estremor.com/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>
  <body>
    <div
      class="absolute top-0 z-[-2] h-screen w-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-neutral-950 dark:to-neutral-900 dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))] transition-colors duration-300"
    >
    </div>
    <ThemeToggle />
    <Header />
    <slot />
    <Footer />
  </body>
  <script>
    import { inject } from "@vercel/analytics";
    import { injectSpeedInsights } from "@vercel/speed-insights";

    inject();
    injectSpeedInsights();
  </script>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  body {
    background: #fafafa;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    transition: background-color 0.3s ease;
  }
  
  body.dark {
    background: #050505;
  }
  
  @media (prefers-color-scheme: dark) {
    body:not(.light) {
      background: #050505;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
